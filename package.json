{
  "name": "dsh-capability-switch",
  "version": "1.5.6",
  "description": "A DSH sidebar plugin for skill-loading takeover, Skill synchronization, and MCP management.",
  "license": "MIT",
  "author": "lock-down",
  "homepage": "https://github.com/lock-down/dsh-capability-switch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lock-down/dsh-capability-switch.git"
  },
  "bugs": {
    "url": "https://github.com/lock-down/dsh-capability-switch/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skills",
    "mcp",
    "plugin"
  ],
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "test:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File test/run-windows.ps1"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
